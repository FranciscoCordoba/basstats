meta {
  name: 02 - Login Equipo
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "correo": "condores@basstats.com",
    "contrasena": "Equipo123!"
  }
}

tests {
  test("status should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("team role verified", function() {
    expect(res.getBody().data.user.rol).to.equal("Equipo");
  });
}
