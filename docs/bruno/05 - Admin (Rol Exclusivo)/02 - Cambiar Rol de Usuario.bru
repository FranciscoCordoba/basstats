meta {
  name: 02 - Cambiar Rol de Usuario
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/admin/usuarios/3/rol
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rol": "Administrador"
  }
}

tests {
  test("status should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("role updated to Administrador", function() {
    expect(res.getBody().data.rol).to.equal("Administrador");
  });
}
