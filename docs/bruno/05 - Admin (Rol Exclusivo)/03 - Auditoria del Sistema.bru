meta {
  name: 03 - Auditoria del Sistema
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/admin/audit
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("audit stats calculated", function() {
    expect(res.getBody().data.totalUsuarios).to.be.a("number");
    expect(res.getBody().data.totalJugadores).to.be.a("number");
    expect(res.getBody().data.totalPartidos).to.be.a("number");
  });
}
