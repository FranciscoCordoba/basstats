meta {
  name: 01 - Listar Partidos (Paginado)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/partidos?page=1&limit=5
  body: none
  auth: none
}

tests {
  test("status should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns list of games", function() {
    expect(res.getBody().data).to.be.an("array");
    expect(res.getBody().pagination.page).to.equal(1);
  });
}
